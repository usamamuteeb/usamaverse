{
  "name": "usamaverse",
  "version": "0.1.0",
  "private": true,
  "description": "Public, anonymous, browser-local toolbox. Brand name is a configurable placeholder.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@emoji-mart/data": "^1.2.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "@scure/bip39": "^2.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "docx": "^9.12.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "next": "^16.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "pptx-browser": "^4.1.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
